IMAGE logo_sega "images/sega_logo.png" BEST ALL
PALETTE buffer_palette "palette/buffer_palette.png"

IMAGE background "images/background.png" BEST ALL
IMAGE game_select "images/game_select.png" BEST ALL
IMAGE button_select "images/start_button.png" BEST ALL
TILESET font_menu "font/font_menu.png" BEST NONE
WAV sega_sfx "sound/sega.wav" XGM
WAV sfx_move "sound/move.wav" XGM
XGM xgm_chippin "music/chippin.vgm"

IMAGE ariel "labels/ariel.png" BEST ALL
IMAGE outrun "labels/outrun.png" BEST ALL
IMAGE robocop_3 "labels/robocop_3.png" BEST ALL
IMAGE space_invaders "labels/space_invaders.png" BEST ALL
IMAGE trouble_shooter "labels/trouble_shooter.png" BEST ALL
IMAGE xman "labels/xman.png" BEST ALL

PALETTE ariel_dark palette/ariel_dark.pal
PALETTE outrun_dark palette/outrun_dark.pal
PALETTE robocop_3_dark palette/robocop_3_dark.pal
PALETTE space_invaders_dark palette/space_invaders_dark.pal
PALETTE trouble_shooter_dark palette/trouble_shooter_dark.pal
PALETTE xman_dark palette/xman_dark.pal