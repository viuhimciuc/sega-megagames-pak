IMAGE logo_sega "images/sega_logo.png" BEST ALL
PALETTE buffer_palette "palette/buffer_palette.png"

IMAGE background "images/background.png" BEST ALL
IMAGE game_select "images/game_select.png" BEST ALL
IMAGE button_select "images/start_button.png" BEST ALL
TILESET font_menu "font/font_menu.png" BEST NONE
WAV sega_sfx "sound/sega.wav" XGM
WAV sfx_move "sound/move.wav" XGM
XGM xgm_chippin "music/chippin.vgm"

IMAGE batman_returns "labels/batman_returns.png" BEST ALL
IMAGE championship_pro "labels/championship_pro.png" BEST ALL
IMAGE fantasia "labels/fantasia.png" BEST ALL
IMAGE talespin "labels/talespin.png" BEST ALL
IMAGE tiny_toon "labels/tiny_toon.png" BEST ALL
IMAGE tom_and_gerry "labels/tom_and_gerry.png" BEST ALL

PALETTE batman_returns_dark palette/batman_returns_dark.pal
PALETTE championship_pro_dark palette/championship_pro_dark.pal
PALETTE fantasia_dark palette/fantasia_dark.pal
PALETTE talespin_dark palette/talespin_dark.pal
PALETTE tiny_toon_dark palette/tiny_toon_dark.pal
PALETTE tom_and_gerry_dark palette/tom_and_gerry_dark.pal