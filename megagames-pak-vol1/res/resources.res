IMAGE logo_sega "images/sega_logo.png" BEST ALL
WAV sega_sfx "sound/sega.wav" XGM
PALETTE buffer_palette "palette/buffer_palette.png"

TILESET font_menu "font/font_menu.png" BEST NONE
IMAGE background "images/background.png" BEST ALL
IMAGE game_select "images/game_select.png" BEST ALL
IMAGE button_select "images/start_button.png" BEST ALL

IMAGE flintstones "labels/flintstones.png" BEST ALL
IMAGE musha "labels/musha.png" BEST ALL
IMAGE quack_shot "labels/quack_shot.png" BEST ALL
IMAGE rambo_3 "labels/rambo_3.png" BEST ALL
IMAGE animaniacs "labels/animaniacs.png" BEST ALL
IMAGE goofys "labels/goofys.png" BEST ALL

PALETTE flintstones_dark palette/flintstones_dark.pal
PALETTE musha_dark palette/musha_dark.pal
PALETTE quack_shot_dark palette/quack_shot_dark.pal
PALETTE rambo_3_dark palette/rambo_3_dark.pal
PALETTE animaniacs_dark palette/animaniacs_dark.pal
PALETTE goofys_dark palette/goofys_dark.pal

XGM xgm_chippin "music/chippin.vgm"
WAV sfx_move "sound/move.wav" XGM